// One copy of the firmware: the Arduino stand-ins and the merged sketch inside the namespace
// LINN_INSTANCE, which the file including this one names, so that each copy has globals of its
// own. Every system header they use is included first, outside the namespace, since a header
// included for the first time inside it would declare the library in the wrong place.
#ifndef LINN_INSTANCE
#error "LINN_INSTANCE names the namespace of this copy of the firmware"
#endif

#include <algorithm>
#include <atomic>
#include <chrono>
