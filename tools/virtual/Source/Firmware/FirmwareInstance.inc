// One copy of the firmware: the Arduino stand-ins and the merged sketch inside the namespace
// LINN_INSTANCE, which the file including this one names, so that each copy has globals of its
// own. Every system header they use is included first, outside the namespace, since a header
// included for the first time inside it would declare the library in the wrong place.
#ifndef LINN_INSTANCE
#error "LINN_INSTANCE names the namespace of this copy of the firmware"
#endif

#include <algorithm>
#include <atomic>
#include <chrono>
#include <climits>
#include <cmath>
#include <cstdarg>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <deque>
#include <functional>
#include <initializer_list>
#include <limits.h>
#include <math.h>
#include <mutex>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <string>
#include <thread>
#include <vector>

#include "FirmwareBridge.h"

namespace LINN_INSTANCE {

// generated by "go run ./tools/linnstrument merge", see CMakeLists.txt
#include "linnstrument-firmware.cpp"
#include "arduino_mock.cpp"

class Copy final : public firmware::Instance {
public:
  void boot(int model, const std::vector<uint8_t>& flashImage, firmware::SerialSink sink) override {
    // setup() never touches these, so a second boot (a model switch) clears them like tests/mocks.cpp does
    if (userFirmwareActive) changeUserFirmwareMode(false);
#ifndef VIRTUAL_OLD_FIRMWARE   // text over MIDI arrived with firmware 2.4.0
    stopMidiTextScroll();
    midiTextAppend(0);
    midiTextFont = 2;
#endif
    midiCellColCC = 0;
    midiCellRowCC = 0;
    controlModeActive = false;
    controlButton = -1;

    host::reset();
    host::useRealClock(true);
    serialSink = std::move(sink);
    host::setSerialSink(sendSerial);
    host::setPin(38, model == 200 ? HIGH : LOW);

    bool fresh = flashImage.size() != LINN_FAKE_FLASH_SIZE;
    if (fresh) {
      dueFlashStorage.erase();
      // a boot block of 255 means "just flashed" and starts serial mode; any other value
      // starts MIDI mode with default settings, as after the Updater restored them
      dueFlashStorage.write(0, 1);
    }
    else {
      memcpy(dueFlashStorage.storage, flashImage.data(), LINN_FAKE_FLASH_SIZE);
    }

    setup();

    if (fresh) {
      controlButton = -1;
      setDisplayMode(displayNormal);
      updateDisplay();
      storeSettings();
    }
  }

  void loopOnce() override {
    loop();
  }

  int cellsPerScan() override {
    return CELLCOUNT;
  }

  int model() override { return LINNMODEL; }
  bool calibrated() override { return Device.calibrated; }
  int columns() override { return NUMCOLS; }
  int rows() override { return NUMROWS; }
  bool userFirmwareMode() override { return userFirmwareActive; }
  bool serialMode() override { return Device.serialMode; }
  bool showingSettings() override { return displayMode != displayNormal; }
  firmware::Screen screen() override {
    switch (displayMode) {
      case displayNormal: return Split[Global.currentPerSplit].sequencer && !userFirmwareActive ? firmware::sequencerScreen : firmware::noScreen;
      case displayPerSplit: return firmware::perSplitScreen;
      case displayGlobal: case displayGlobalWithTempo: return firmware::globalScreen;
      case displaySequencerProjects: return firmware::sequencerProjectsScreen;
      case displaySequencerDrum0107: return firmware::sequencerDrums1Screen;
      case displaySequencerDrum0814: return firmware::sequencerDrums2Screen;
      case displaySequencerColors: return firmware::sequencerColorsScreen;
      case displayPreset: return firmware::presetScreen;
      case displayVolume: return firmware::volumeScreen;
      case displayOctaveTranspose: return firmware::octaveTransposeScreen;
      case displaySplitPoint: return firmware::splitPointScreen;
      case displayCustomLedsEditor: return firmware::customLightsScreen;
      default: return firmware::noScreen;
    }
  }
  bool sequencerNoteSelected() override { return seqState[Global.currentPerSplit].hasFocusEvent(); }
  int bendRange() override { return getBendRange(LEFT); }
  int tempo() override { return FXD4_TO_INT(fxd4CurrentTempo); }

  bool midiPending() override { return !midiOutQueue.empty(); }

  // OSVersion ends and OSVersionBuild starts with the dot the instrument's screen puts between them
  const char* version() override {
    static char text[16];
    snprintf(text, sizeof(text), "%s%s", OSVersion, OSVersionBuild[0] == '.' && OSVersion[strlen(OSVersion) - 1] == '.' ? OSVersionBuild + 1 : OSVersionBuild);
    return text;
  }

  firmware::Led led(int col, int row) override {
    firmware::Led result = { 0, 0 };
    if (col < 0 || col >= NUMCOLS || row < 0 || row >= NUMROWS) return result;
    byte data = ledVisible(LED_LAYER_COMBINED, col, row);
    result.color = (data & B11111000) >> 3;
    result.display = data & B00000111;
    return result;
  }

  // the LED driver keeps these rhythms in statics of its own, so they are mirrored here
  bool pulseOn(int display) override {
    switch (display) {
      case firmware::fastPulse: return (millis() / 80) % 2 == 0;
      case firmware::slowPulse: return (millis() / 120) % 2 == 0;
      case firmware::focusPulse: return clock24PPQ >= 6;
    }
    return display == firmware::on;
  }

  uint16_t rawX(int col, float fraction) override {
    if (col < 1) return (uint16_t)FXD_TO_INT(FXD_CALX_DEFAULT_LEFT_EDGE);
    int width = FXD_TO_INT(FXD_CALX_DEFAULT_CELL_WIDTH);
    int first = FXD_TO_INT(FXD_CALX_DEFAULT_FIRST_CELL);
    // the default calibration puts each column's reference at the middle of its pad
    int x = first + (col - 1) * width + (int)((fraction - 0.5f) * width);
    if (x < 0) x = 0;
    if (x > 4095) x = 4095;
    return (uint16_t)x;
  }

  uint16_t rawY(int row, float fraction) override {
    if (row < 0 || row >= NUMROWS) return 0;
    int low = CALY_DEFAULT_MIN[row];
    int high = CALY_DEFAULT_MAX[row];
    return (uint16_t)(low + (int)(fraction * (high - low)));
  }

  void setSensor(int col, int row, uint16_t x, uint16_t y, uint16_t z) override {
    host::setSensor((uint8_t)col, (uint8_t)row, x, y, z);
  }

  void feedMidi(const uint8_t* data, size_t length) override {
    host::feedSerial(data, length);
  }

  // the pins read LOW at startup, so a normally open switch is assumed and HIGH is pressed
  void footSwitch(int which, bool down) override {
    host::setPin(which == 0 ? FOOT_SW_LEFT : FOOT_SW_RIGHT, down ? HIGH : LOW);
  }

  std::vector<uint8_t> flashImage() override {
    return std::vector<uint8_t>(dueFlashStorage.storage, dueFlashStorage.storage + LINN_FAKE_FLASH_SIZE);
  }

  size_t flashSize() override {
    return LINN_FAKE_FLASH_SIZE;
  }

private:
  static void sendSerial(const uint8_t* data, size_t length) {
    if (serialSink) serialSink(data, length);
  }
  static firmware::SerialSink serialSink;
};

firmware::SerialSink Copy::serialSink;

static Copy copy;
static const bool added = (firmware::add(&copy), true);

}
